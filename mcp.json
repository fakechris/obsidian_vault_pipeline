{
  "mcpServers": {
    "ovp": {
      "command": "${OVP2_BIN:-ovp2}",
      "args": [
        "mcp",
        "--vault-root",
        "${OVP_VAULT_ROOT}"
      ],
      "env": {
        "OVP_VAULT_ROOT": "${OVP_VAULT_ROOT:-/path/to/your/vault}",
        "OVP_LLM_NO_PROXY": "${OVP_LLM_NO_PROXY:-1}"
      }
    }
  }
}
